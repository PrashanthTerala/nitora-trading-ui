    "gsap": "3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
